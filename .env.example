
ADMIN_PASSWORD=
# Chave aleatória para assinar a sessão do painel (gere com: openssl rand -hex 32). Use uma diferente em produção.
SESSION_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# WhatsApp da Evy, só dígitos com DDI e DDD (ex.: 5511999999999). Não é a chave Pix.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Agente de IA (Groq, API compativel com OpenAI). Apenas no servidor.
# Padrao do codigo: "openai/gpt-oss-120b". O modelo precisa suportar tool use;
# confira o nome em console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=
